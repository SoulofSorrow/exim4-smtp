{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(shellcheck:*)",
      "Bash(hadolint:*)",
      "Bash(docker build:*)"
    ],
    "ask": [
      "Bash(docker push:*)",
      "Bash(docker buildx build:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  }
}
